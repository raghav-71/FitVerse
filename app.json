{
  "expo": {
    "name": "FitVerse AI",
    "slug": "fitverse-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/fitverse_splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow FitVerse to access camera for AI form tracking"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow FitVerse to access your photos to log meals"
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fitverse.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Allow FitVerse to access camera for AI form tracking",
        "NSPhotoLibraryUsageDescription": "Allow FitVerse to access your photos to log meals"
      }
    },
    "android": {
      "package": "com.fitverse.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "24914999-82ee-48fd-b0e6-b1cfdf381bac"
      }
    },
    "owner": "sihteam"
  }
}
